{
  "name": "mmmodel",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:no-turbo": "next dev",
    "dev:turbo": "next dev --turbopack",
    "build": "DATABASE_URL=\"postgresql://dummy:dummy@localhost:5432/dummy\" next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs": "typedoc",
    "docs:check": "typedoc --emit none --treatWarningsAsErrors false",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "sync:models": "node --env-file=.env.local --import tsx scripts/sync-openrouter-models.ts",
    "dev-auto-exit": "timeout 30 next dev --turbopack || echo 'Dev server test completed'",
    "types:check": "tsc --noEmit && tsd",
    "types:strict": "tsc --project tsconfig.strict.json --noEmit",
    "design:audit": "node scripts/audit-design-system.js",
    "prebuild": "echo Skipping quality check for deployment",
    "models:unavailable": "tsx scripts/manage-model-availability.ts --list",
    "models:restore": "tsx scripts/manage-model-availability.ts --restore",
    "models:restore-all": "tsx scripts/manage-model-availability.ts --restore-all",
    "models:stats": "tsx scripts/manage-model-availability.ts --stats",
    "prepare": "husky install",
    "pre-push": "pnpm format && pnpm lint:fix && pnpm format:check && pnpm lint && pnpm test && pnpm docs:check --treatWarningsAsErrors false"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,yml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@dicebear/collection": "^9.2.2",
    "@dicebear/core": "^9.2.2",
    "@fontsource/fira-mono": "^5.2.6",
    "@jest/globals": "^30.0.2",
    "@neondatabase/serverless": "^1.0.1",
    "@privy-io/react-auth": "^2.14.2",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-slot": "^1.2.3",
    "autoprefixer": "^10.4.21",
    "chart.js": "^4.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dompurify": "^3.2.6",
    "dotenv": "^16.5.0",
    "drizzle-orm": "^0.44.2",
    "html-react-parser": "^5.2.5",
    "jose": "^5.3.0",
    "lucide-react": "^0.515.0",
    "nanoid": "^5.1.5",
    "next": "^15.3.4",
    "next-logger": "^5.0.1",
    "next-themes": "^0.4.6",
    "pino": "^9.7.0",
    "postcss": "^8.5.6",
    "postgres": "^3.4.7",
    "react": "^19.0.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.5",
    "swr": "^2.3.3",
    "tailwind-glassmorphism": "^1.0.6",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.3.4",
    "uuid": "^9.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@next/eslint-plugin-next": "^15.3.4",
    "@playwright/test": "^1.53.1",
    "@tailwindcss/postcss": "^4.1.11",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^14.2.0",
    "@testing-library/user-event": "^14.4.3",
    "@types/jest": "^29.5.5",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^20.19.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/uuid": "^9.0.4",
    "@typescript-eslint/eslint-plugin": "^7.9.0",
    "drizzle-kit": "0.31.1",
    "eslint": "^9",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.1.4",
    "husky": "^9.0.11",
    "jest": "^29.7.0",
    "jest-axe": "^10.0.0",
    "jest-environment-jsdom": "^30.0.2",
    "lint-staged": "^15.2.2",
    "prettier": "^3.3.2",
    "tailwindcss": "^4.1.10",
    "ts-jest": "^29.1.1",
    "tsd": "^0.29.0",
    "tsx": "^4.20.3",
    "typedoc": "^0.28.5",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.0"
  }
}
